<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DSFS.App</RootNamespace>
    <AssemblyName>DSFS.App</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSFS.Core\DSFS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled demo corpus (Load Sample Dataset button) - copied next to the .exe on build. -->
    <Content Include="SampleDocuments\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
